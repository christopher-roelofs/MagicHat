#!/usr/bin/env python3
"""Report how much each framebuffer dump differs from a reference.

Counting non-white pixels is not enough to tell screens apart — Magic Cap's
calibration steps show the same content in different places, so the count
stays identical while the screen changes completely.
"""
import sys

def load(p):
    d = open(p, 'rb').read()
    return d[d.index(b'255\n') + 4:]

def main():
    if len(sys.argv) < 3:
        sys.exit("usage: fbdiff <reference.pgm> <frame.pgm>...")
    ref = load(sys.argv[1])
    W = 480
    for path in sys.argv[2:]:
        px = load(path)
        diff = [k for k in range(min(len(ref), len(px))) if ref[k] != px[k]]
        name = path.split('/')[-1]
        if not diff:
            print(f"{name:16s} identical")
            continue
        xs = [k % W for k in diff]
        ys = [k // W for k in diff]
        print(f"{name:16s} {len(diff):6d} px differ, "
              f"bbox x {min(xs)}..{max(xs)} y {min(ys)}..{max(ys)}")

main()
